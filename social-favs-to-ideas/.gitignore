# Generated Dynamic Data Files (Keep structure, ignore user runtime data)
data/raw_favs.json
data/content_ideas_database.md
data/*.png
data/*.jpg
data/*.log
!.data/.gitkeep

# Environment & IDE Configs
.env
.vscode/
.idea/
*.swp
